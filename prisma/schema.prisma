generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Student {
  id                        String   @id @default(uuid())
  name                      String   @map("name")
  email                     String   @map("email")
  phone                     String   @map("phone")
  course                    String   @map("learning_track")
  sex                       String   @map("gender")
  country                   String   @map("country")
  state                     String?  @map("state_of_residence")
  employment_status         String   @map("current_employment_status")
  has_laptop                String   @map("has_laptop_and_internet")
  reason                    String   @map("why_learn_this_skill")
  payment_status            String   @map("payment_plan") @default("Not Paid Yet")
  password                  String   @default("123456")
  pin                       String   @default("123456") @map("pin")
  reg_date                  String   @map("reg_date")
  reg_time                  String   @map("reg_time")
  restricted                Boolean  @default(false)
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@map("students")
}

model Message {
  id            String   @id @default(uuid())
  title         String
  content       String
  course        String   // Course slug (e.g., 'cybersecurity', 'data-science')
  sender_name   String   // Teacher/mentor name
  created_at    DateTime @default(now()) @map("created_at")
  updated_at    DateTime @updatedAt @map("updated_at")

  @@map("messages")
}
