  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "dev:academy",
      "path": "..",
      "isBackground": true,
      "problemMatcher": {
        "owner": "next",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting\\.\\.\\.",
          "endsPattern": "Ready in"
        }
      }
    }
  ]
}
